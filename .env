# Адрес проекта Supabase и его публичный ключ.
#
# Ключ publishable не является секретом: он по устройству системы попадает в
# браузер каждому, кто открывает приложение. Данные защищает не он, а правила
# доступа в самой базе (см. supabase/setup.sql, часть 2): чат ивента виден
# только его участникам, баланс QP — только владельцу, оценки анонимны.
#
# Прежний ключ anon (вида eyJ...) в этом проекте работал с базой, но функции
# его уже не принимают: Supabase перевёл проект на новую систему ключей.
VITE_SUPABASE_URL=https://lhtxrksxuyxujtehvnzn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_KQMlc6C9jVdxvSOOkUZOug_VfppovVL

# Ключ JavaScript API Яндекс Карт (карта, метки, оформление) и HTTP Геокодера.
# Как и ключ Supabase, он не секрет: уезжает в браузер каждому, кто открыл
# приложение. Защищает его не скрытность, а ограничение по домену в кабинете
# разработчика — там у ключа прописан referer maxgladee.github.io.
VITE_YANDEX_MAPS_KEY=c2c2d43b-7c50-4493-9563-26d7a1a82877
